{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks-handlers/inject-handoff.sh",
            "timeout": 10,
            "statusMessage": "Loading session handoff…"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks-handlers/inject-handoff.sh",
            "timeout": 10,
            "statusMessage": "Reloading session handoff…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks-handlers/claudemd-pointer.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
